#!/bin/bash
#PBS -P sa4
#PBS -q normal
#PBS -l ncpus=1
#PBS -l mem=16GB
#PBS -l jobfs=10GB
#PBS -l walltime=08:00:00
#PBS -l storage=gdata/sa4+scratch/sa4
#PBS -l wd
#PBS -r y
#PBS -N spiking_cat_90vs180
#PBS -o logs/model_spiking_cat_90vs180_gadi.out
#PBS -e logs/model_spiking_cat_90vs180_gadi.err

set -euo pipefail

MODULE_PYTHON="${MODULE_PYTHON:-python3/3.11.0}"
VENV_DIR="${VENV_DIR:-$PBS_O_WORKDIR/.venv-model_spiking_cat_90vs180_gadi}"

mkdir -p logs

module load "${MODULE_PYTHON}"
cd "$PBS_O_WORKDIR"

if [ ! -d "${VENV_DIR}" ]; then
  echo "Missing virtual environment: ${VENV_DIR}" >&2
  echo "Run: bash gadi/setup_model_spiking_cat_90vs180_env.sh" >&2
  exit 1
fi

. "${VENV_DIR}/bin/activate"

export OMP_NUM_THREADS=1
export OPENBLAS_NUM_THREADS=1
export MKL_NUM_THREADS=1
export NUMEXPR_NUM_THREADS=1

python3 code/model_spiking_cat_90vs180_gadi.py \
  --rotations 90 180 \
  --n-simulations 1 \
  --n-trials 600 \
  --probe-trial-onsets 600 \
  --n-probe-trials 200
